---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getCollection, render } from 'astro:content';
import { blogServiceMap, serviceLinks, serviceAreas } from '../../data/internalLinks';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = `${post.data.title} | HiLo Heating & Air`;
const description = post.data.description;
const articleData = {
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: post.data.author,
  category: post.data.category,
  image: post.data.image ? `https://hiloheatingandair.com${post.data.image}` : undefined,
};
const slugKey = post.id.replace(/\.md$/, '');
const relatedServices = blogServiceMap[slugKey] || [serviceLinks.hvac, serviceLinks.airConditioning, serviceLinks.heating];

const blogFaqSchemas: Record<string, object> = {
  'ac-repair-anaheim-same-day-emergency': {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How much does AC repair cost in Anaheim?",
        "acceptedAnswer": { "@type": "Answer", "text": "It depends on the part and labor. You get an exact price before any work begins, and the diagnostic fee is waived if you approve the repair." }
      },
      {
        "@type": "Question",
        "name": "Do you offer same-day AC repair?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Most calls get a technician out the same day." }
      },
      {
        "@type": "Question",
        "name": "Do you offer emergency HVAC repair at night or on weekends?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Our emergency HVAC repair line is staffed 24/7 at (714) 853-5534." }
      },
      {
        "@type": "Question",
        "name": "Why is my AC running but not cooling?",
        "acceptedAnswer": { "@type": "Answer", "text": "Common causes include a dirty filter, a failed capacitor, a frozen coil, or a refrigerant leak." }
      },
      {
        "@type": "Question",
        "name": "Why is water leaking from my indoor unit?",
        "acceptedAnswer": { "@type": "Answer", "text": "Usually because of a clogged condensate drain or a frozen coil that is melting." }
      },
      {
        "@type": "Question",
        "name": "Is it worth repairing a 10-year-old AC?",
        "acceptedAnswer": { "@type": "Answer", "text": "Often, yes. Compare the repair cost, the refrigerant type, and your system's repair history before deciding." }
      },
      {
        "@type": "Question",
        "name": "Can I still repair an R-22 system?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. The EPA does not require R-22 systems to be replaced, but recharges can be expensive." }
      },
      {
        "@type": "Question",
        "name": "Should I keep running my AC if it's making a strange noise?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. Turn it off and call a technician to avoid further damage." }
      },
      {
        "@type": "Question",
        "name": "How can I prevent future breakdowns?",
        "acceptedAnswer": { "@type": "Answer", "text": "Change filters regularly and schedule AC maintenance before summer." }
      },
      {
        "@type": "Question",
        "name": "Are your technicians licensed?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. We hold California C-20 license #1155955, and our technicians are EPA-certified." }
      }
    ]
  },
  'commercial-hvac-services-guide': {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How is commercial HVAC different from residential HVAC?",
        "acceptedAnswer": { "@type": "Answer", "text": "Commercial systems typically use rooftop package units or multi-zone setups sized for larger spaces, unlike the single split system in most homes." }
      },
      {
        "@type": "Question",
        "name": "What types of businesses need commercial HVAC service?",
        "acceptedAnswer": { "@type": "Answer", "text": "Offices, restaurants, retail stores, warehouses, and medical facilities all use commercial-grade equipment with different needs than a house." }
      },
      {
        "@type": "Question",
        "name": "Can commercial HVAC maintenance be scheduled around business hours?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Maintenance and non-emergency repairs can typically be scheduled before opening, after closing, or during slower periods." }
      },
      {
        "@type": "Question",
        "name": "How fast is emergency heating repair for a commercial property?",
        "acceptedAnswer": { "@type": "Answer", "text": "Same-day dispatch is standard, with 24/7 emergency service available for total system failures." }
      },
      {
        "@type": "Question",
        "name": "Why do rooftop units need regular checkups?",
        "acceptedAnswer": { "@type": "Answer", "text": "Rooftop units often fail gradually rather than suddenly, and slow refrigerant leaks or worn components are easier to catch during scheduled visits." }
      },
      {
        "@type": "Question",
        "name": "Is furnace repair different for commercial buildings in Los Angeles?",
        "acceptedAnswer": { "@type": "Answer", "text": "Commercial furnaces are often larger and older than residential units, and repairs need to account for how the space is actually used now." }
      },
      {
        "@type": "Question",
        "name": "Are technicians licensed and insured for commercial HVAC work?",
        "acceptedAnswer": { "@type": "Answer", "text": "Technicians should hold EPA Section 608 certification for refrigerant work, and the contractor's license can be verified through the CSLB." }
      },
      {
        "@type": "Question",
        "name": "What does a commercial HVAC maintenance service actually include?",
        "acceptedAnswer": { "@type": "Answer", "text": "Typically filter changes, coil cleaning, refrigerant level checks, electrical connection inspection, and airflow testing." }
      },
      {
        "@type": "Question",
        "name": "Who is responsible for HVAC repairs in a leased commercial space?",
        "acceptedAnswer": { "@type": "Answer", "text": "Responsibility varies by lease terms, so confirming who can authorize repair work before an emergency happens prevents delays." }
      },
      {
        "@type": "Question",
        "name": "How do I get started with commercial HVAC service?",
        "acceptedAnswer": { "@type": "Answer", "text": "Contact the company directly to schedule a diagnostic visit or set up an ongoing maintenance contract." }
      }
    ]
  }
};

const faqSchema = blogFaqSchemas[slugKey];
---

<BaseLayout title={title} description={description} article={articleData} faqSchema={faqSchema}>
  <Header />
  <main>
    <article>
      <div class="bg-gradient-to-br from-brand-blue to-blue-800 pt-20 sm:pt-28 pb-0">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <div class="flex items-center justify-center gap-3 mb-6">
            <span class="text-xs font-semibold text-brand-blue bg-white/20 backdrop-blur-sm px-3 py-1 rounded-full">{post.data.category}</span>
            <time class="text-xs text-white/60" datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </time>
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">{post.data.title}</h1>
          <p class="text-white/85 text-lg max-w-2xl mx-auto mb-12">Written by {post.data.author}</p>
        </div>

        {post.data.image && (
          <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <img
              src={post.data.image}
              alt={post.data.title}
              class="w-full rounded-t-2xl shadow-2xl object-cover aspect-[16/9]"
            />
          </div>
        )}
      </div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <Breadcrumbs />
      </div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
        <div class="prose prose-lg prose-slate max-w-none prose-headings:text-gray-900 prose-headings:font-bold prose-p:text-gray-600 prose-p:leading-relaxed prose-a:text-brand-blue prose-a:no-underline hover:prose-a:underline prose-strong:text-gray-900 prose-li:text-gray-600">
          <Content />
        </div>
      </div>

      {/* Internal Linking: Related Services */}
      <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 sm:p-8">
          <h3 class="text-lg font-bold text-brand-blue mb-2">Need help with this? HiLo can help.</h3>
          <p class="text-sm text-slate-600 mb-4">Related services from HiLo Heating & Air:</p>
          <div class="flex flex-wrap gap-2">
            {relatedServices.map((svc) => (
              <a href={svc.href} class="inline-flex items-center gap-1.5 px-4 py-2 bg-white border border-slate-200 rounded-full text-sm font-semibold text-brand-blue hover:bg-brand-blue hover:text-white hover:border-brand-blue transition">{svc.name}</a>
            ))}
          </div>
          <div class="mt-4 flex flex-wrap gap-2">
            <a href="/services/" class="text-sm font-semibold text-slate-500 hover:text-brand-blue">All services →</a>
            <span class="text-slate-300">·</span>
            <a href="/service-areas/" class="text-sm font-semibold text-slate-500 hover:text-brand-blue">Service areas →</a>
            <span class="text-slate-300">·</span>
            <a href="/contact-us/" class="text-sm font-semibold text-slate-500 hover:text-brand-blue">Contact us →</a>
          </div>
        </div>
      </section>

      {/* Service Areas for this post */}
      <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
        <div class="flex flex-wrap gap-2 justify-center">
          {serviceAreas.slice(0, 8).map((area) => (
            <a href={area.href} class="text-xs font-medium text-slate-500 bg-white border border-slate-200 px-3 py-1.5 rounded-full hover:border-brand-blue hover:text-brand-blue transition">{area.name}</a>
          ))}
          <a href="/service-areas/" class="text-xs font-semibold text-brand-blue px-3 py-1.5">View all →</a>
        </div>
      </section>

      <RelatedPosts currentSlug={post.id} category={post.data.category} />

      <div class="bg-slate-50 py-16 sm:py-20">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">Need HVAC Help?</h2>
          <p class="text-gray-500 mb-8">Call HiLo Heating and Air today for expert service. <a href="/services/" class="text-brand-blue underline hover:text-brand-red">Explore our services</a> or <a href="/service-areas/" class="text-brand-blue underline hover:text-brand-red">find your city</a>.</p>
          <a href="tel:+17148535534" class="inline-flex items-center gap-2 bg-brand-blue text-white font-bold px-8 py-4 rounded-lg hover:bg-blue-700 transition text-lg">
            (714) 853-5534
          </a>
        </div>
      </div>

      <div class="py-10 sm:py-12">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap gap-3">
          <a href="/blogs/" class="inline-flex items-center gap-2 text-brand-blue font-semibold hover:underline">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Back to All Blogs
          </a>
          <span class="text-slate-300">·</span>
          <a href="/services/" class="inline-flex items-center gap-1 text-slate-600 font-medium hover:text-brand-blue">Services</a>
          <span class="text-slate-300">·</span>
          <a href="/service-areas/" class="inline-flex items-center gap-1 text-slate-600 font-medium hover:text-brand-blue">Service Areas</a>
        </div>
      </div>
    </article>

    <CTASection client:visible />
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .prose h2 {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }
  .prose h3 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }
  .prose p {
    margin-bottom: 1.25rem;
  }
  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose blockquote {
    border-left: 4px solid var(--color-brand-blue);
    padding-left: 1.5rem;
    font-style: italic;
    color: #4b5563;
    margin: 1.5rem 0;
  }
  .prose strong {
    font-weight: 700;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 1.5rem 0;
    display: table;
  }
  .prose thead th {
    background-color: var(--color-brand-blue);
    color: #fff;
    text-align: left;
    font-weight: 600;
    padding: 0.75rem 1rem;
    white-space: nowrap;
  }
  .prose tbody th {
    background-color: #f1f5f9;
    text-align: left;
    font-weight: 600;
    color: #1e293b;
    padding: 0.75rem 1rem;
    vertical-align: top;
  }
  .prose tbody td {
    padding: 0.75rem 1rem;
    border: 1px solid #e2e8f0;
    vertical-align: top;
    color: #475569;
  }
  .prose tbody tr:nth-child(even) td {
    background-color: #f8fafc;
  }
  .faq-accordion {
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .faq-item {
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    background: #fff;
    overflow: hidden;
  }
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    font-weight: 600;
    color: var(--color-brand-blue);
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary:focus-visible {
    outline: 2px solid var(--color-brand-blue);
    outline-offset: -2px;
    border-radius: 0.75rem;
  }
  .faq-item summary::after {
    content: "+";
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1;
    color: var(--color-brand-blue);
    transition: transform 0.3s ease;
  }
  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }
  .faq-item .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  .faq-item[open] .faq-body {
    grid-template-rows: 1fr;
  }
  .faq-item .faq-content {
    overflow: hidden;
  }
  .faq-item .faq-content p {
    padding: 0 1.25rem 1.1rem;
    margin: 0;
    color: #475569;
    font-size: 0.95rem;
  }
</style>
