---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const projects = [
  { href: '/images/projects/project-1.png', src: '/images/projects/project-1.png', alt: 'HiLo Heating & Air HVAC installation project' },
  { href: '/images/projects/project-2.png', src: '/images/projects/project-2.png', alt: 'HiLo Heating & Air HVAC repair project' },
  { href: '/images/projects/project-3.png', src: '/images/projects/project-3.png', alt: 'HiLo Heating & Air furnace installation' },
  { href: '/images/projects/project-4.jpg', src: '/images/projects/project-4.jpg', alt: 'HiLo Heating & Air AC replacement' },
  { href: '/images/projects/project-5.jpg', src: '/images/projects/project-5.jpg', alt: 'HiLo Heating & Air ductwork project' },
  { href: '/images/projects/project-6.jpg', src: '/images/projects/project-6.jpg', alt: 'HiLo Heating & Air mini-split installation' },
  { href: '/images/projects/project-7.jpg', src: '/images/projects/project-7.jpg', alt: 'HiLo Heating & Air emergency repair' },
  { href: '/images/projects/project-8.jpg', src: '/images/projects/project-8.jpg', alt: 'HiLo Heating & Air commercial HVAC' },
  { href: '/images/projects/project-9.jpg', src: '/images/projects/project-9.jpg', alt: 'HiLo Heating & Air maintenance project' },
];
---

<BaseLayout title="HVAC Projects | HiLo Heating & Air" description="See our recent HVAC installation, repair, and maintenance projects across Orange County — Stanton, Anaheim, Irvine, Santa Ana, Orange, Fullerton, and beyond. Free estimates on all installations.">
  <Header />
  <main>
    <!-- Free Estimates Banner -->
    <section class="bg-brand-red text-white py-3 sm:py-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-sm sm:text-base font-semibold">
          💰 Free estimates on all installations &nbsp;·&nbsp; Call (714) 853-5534 &nbsp;·&nbsp;
          <a href="https://share.google/Xr1KLRM21kgxpA2Ef" class="underline hover:text-brand-yellow/80 transition">See our Google reviews</a>
        </p>
      </div>
    </section>

    <section class="py-16 sm:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h1 class="text-3xl sm:text-4xl font-bold text-brand-blue mb-4">Recent HVAC Projects</h1>
          <p class="text-slate-600 max-w-2xl mx-auto">See our recent heating, cooling, and ductwork installations across Orange County. From Stanton to Anaheim, Irvine to Santa Ana — HiLo Heating & Air delivers quality work every time.</p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {projects.map((p) => (
            <a href={p.href} target="_blank" rel="noopener noreferrer" class="block rounded-xl overflow-hidden hover:scale-105 transition duration-300 border border-slate-200">
              <img src={p.src} alt={p.alt} class="w-full h-48 object-cover" loading="lazy" />
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-24 bg-slate-50 border-y border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-brand-blue mb-4">Ready for Your HVAC Project?</h2>
        <p class="text-slate-600 mb-8 max-w-2xl mx-auto">Whether you need AC repair, furnace installation, or a full HVAC replacement in Orange County, HiLo Heating & Air is ready to help. Same-day service, free diagnostics with repair, and upfront pricing.</p>
        <a href="tel:+17148535534" class="inline-block bg-brand-blue text-white font-bold px-8 py-4 rounded-lg hover:bg-blue-700 transition text-lg">
          (714) 853-5534
        </a>
        <a href="/contact-us/" class="inline-block ml-4 bg-brand-red text-white font-bold px-8 py-4 rounded-lg hover:bg-red-700 transition text-lg">
          Request Service Online
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
