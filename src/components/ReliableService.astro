---
import { Image } from 'astro:assets';
import repair3 from '../assets/repair-3.webp';
import chatgpt from '../assets/chatgpt-reliable.webp';
import reliableRepair from '../assets/reliable-repair.webp';
import repair5 from '../assets/repair-5.webp';

const slides = [
  { src: repair3, alt: 'Heating and cooling system service' },
  { src: chatgpt, alt: 'HiLo Heating & Air trusted HVAC service for Orange County homes' },
  { src: reliableRepair, alt: 'HiLo Heating & Air professional HVAC repair service' },
  { src: repair5, alt: 'Expert HVAC maintenance and repair' },
];
---

<section class="py-16 sm:py-24 bg-[#f3f7f9]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div>
          <span class="text-xs font-bold text-[#cc0000] uppercase tracking-wider block mb-1">Why HiLo Heating & Air</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-[#002d62] leading-tight">Reliable Service When You Need It Most</h2>
        </div>
        <p class="text-sm text-[#002d62]/85 font-medium max-w-xl">Since 2000, we've been providing honest, upfront HVAC services to homeowners across Orange County. No pressure, no hidden fees — just reliable workmanship.</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          {[
            { title: 'Licensed & Insured', desc: 'Fully licensed and insured for your protection. Our technicians are EPA certified and background checked.' },
            { title: 'Same-Day Service', desc: 'Most calls get a technician out the same day. We carry common parts so most repairs are handled in one visit.' },
            { title: 'Upfront Pricing', desc: 'Know the cost before any work begins. No surprise charges, no hidden fees, no emergency markups.' },
            { title: 'Satisfaction Guaranteed', desc: 'Every repair and installation is backed by our warranty. If it is not right, we make it right.' },
          ].map((f) => (
            <div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm space-y-2 relative overflow-hidden group">
              <h3 class="text-base font-bold text-[#002d62] pt-1.5 group-hover:text-[#cc0000] transition-colors">{f.title}</h3>
              <p class="text-xs text-slate-600 font-semibold leading-relaxed">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="lg:col-span-5 flex flex-col space-y-6">
        <div class="relative bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-lg p-3">
          <div class="relative rounded-xl overflow-hidden aspect-square bg-[#002d62]">
            <div class="relative h-full w-full group" data-reliable-carousel>
              {slides.map((s, i) => (
                <div
                  class={`absolute inset-0 transition-opacity duration-700 ease-in-out ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                  data-slide={i}
                  aria-hidden={i === 0 ? 'false' : 'true'}
                >
                  <Image src={s.src} alt={s.alt} class="object-cover w-full h-full" widths={[800, 640, 480]} sizes="(max-width: 1024px) 100vw, 50vw" />
                </div>
              ))}

              <button
                type="button"
                class="absolute left-2 top-1/2 -translate-y-1/2 z-10 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-black/35 backdrop-blur-sm text-white flex items-center justify-center hover:bg-[#cc0000] transition-colors opacity-80 sm:opacity-0 sm:group-hover:opacity-100"
                aria-label="Previous image"
                data-reliable-prev
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" strokeWidth="2.5"><path strokeLinecap="round" strokeLinejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
              </button>
              <button
                type="button"
                class="absolute right-2 top-1/2 -translate-y-1/2 z-10 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-black/35 backdrop-blur-sm text-white flex items-center justify-center hover:bg-[#cc0000] transition-colors opacity-80 sm:opacity-0 sm:group-hover:opacity-100"
                aria-label="Next image"
                data-reliable-next
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" strokeWidth="2.5"><path strokeLinecap="round" strokeLinejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
              </button>

              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-10 flex items-center gap-2">
                {slides.map((_, i) => (
                  <button
                    key={i}
                    type="button"
                    class={`h-2 rounded-full transition-all duration-300 ${i === 0 ? 'w-7 bg-[#cc0000]' : 'w-2 bg-white/70 hover:bg-white'}`}
                    aria-label={`Go to slide ${i + 1}`}
                    aria-current={i === 0 ? 'true' : 'false'}
                    data-reliable-dot={i}
                  />
                ))}
              </div>
            </div>
          </div>
          <div class="pt-4 px-2 pb-2 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-t border-brand-blue/5 mt-3">
            <div>
              <span class="text-[10px] font-bold text-[#cc0000] uppercase tracking-wider block">Need Help Now?</span>
              <h4 class="text-sm font-extrabold text-[#002d62]">Same-Day Dispatch Available</h4>
              <a href="/services/air-conditioning-services/emergency-ac-repair/" class="text-brand-blue underline hover:text-brand-red text-xs font-semibold">emergency AC repair</a>
            </div>
            <a href="tel:+17148535534" class="bg-[#cc0000] text-white text-xs font-extrabold px-4 py-2.5 rounded shadow hover:bg-[#002d62] transition-colors flex-shrink-0">Call Now</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-reliable-carousel]');
  if (root) {
    const slides = Array.from(root.querySelectorAll('[data-slide]'));
    const dots = Array.from(root.querySelectorAll('[data-reliable-dot]'));
    const prevBtn = root.querySelector('[data-reliable-prev]');
    const nextBtn = root.querySelector('[data-reliable-next]');
    const total = slides.length;
    const AUTO_ADVANCE_MS = 3000;
    let index = 0;
    let timer = 0;
    let paused = false;

    const setActive = (next) => {
      index = (next + total) % total;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('opacity-100', active);
        slide.classList.toggle('opacity-0', !active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('w-7', active);
        dot.classList.toggle('bg-[#cc0000]', active);
        dot.classList.toggle('w-2', !active);
        dot.classList.toggle('bg-white/70', !active);
        dot.setAttribute('aria-current', String(active));
      });
    };

    const start = () => {
      clearInterval(timer);
      timer = window.setInterval(() => {
        if (!paused) setActive(index + 1);
      }, AUTO_ADVANCE_MS);
    };

    prevBtn?.addEventListener('click', () => { setActive(index - 1); start(); });
    nextBtn?.addEventListener('click', () => { setActive(index + 1); start(); });
    dots.forEach((dot, i) => dot.addEventListener('click', () => { setActive(i); start(); }));

    root.addEventListener('mouseenter', () => { paused = true; });
    root.addEventListener('mouseleave', () => { paused = false; });
    root.addEventListener('focusin', () => { paused = true; });
    root.addEventListener('focusout', () => { paused = false; });

    start();
  }
</script>