---
interface Props {
  title?: string;
  subtitle?: string;
}

const { 
  title = "Our Service Fleet",
  subtitle = "Professional HVAC vehicles ready to serve your home"
} = Astro.props;
---

<section class="py-16 sm:py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-brand-blue mb-4">{title}</h2>
      <p class="text-slate-600 max-w-2xl mx-auto">{subtitle}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="relative overflow-hidden rounded-2xl group">
        <img 
          src="/images/hilo-van-front.jpg" 
          alt="HiLo Heating and Air service van front view" 
          class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-blue/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </div>
      <div class="relative overflow-hidden rounded-2xl group">
        <img 
          src="/images/hilo-van-side.jpg" 
          alt="HiLo Heating and Air service van side view" 
          class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-blue/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </div>
      <div class="relative overflow-hidden rounded-2xl group">
        <img 
          src="/images/hilo-van-angle.jpg" 
          alt="HiLo Heating and Air service van angle view" 
          class="w-full h-64 object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-blue/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </div>
    </div>
  </div>
</section>
