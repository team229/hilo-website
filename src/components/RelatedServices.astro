---
import { getRelated, type LinkItem } from '../data/internalLinks';

interface Props {
  relatedKey?: string;
  title?: string;
  subtitle?: string;
  links?: LinkItem[];
  services?: LinkItem[]; // alias for links
  variant?: 'cards' | 'list';
}

const { relatedKey, title = 'Related Services', subtitle = 'Explore more ways we can help keep your home comfortable', links: propLinks, services: servicesAlias, variant = 'cards' } = Astro.props;

const links: LinkItem[] = propLinks ?? servicesAlias ?? (relatedKey ? getRelated(relatedKey) : []);
---

{links.length > 0 && (
  <section class="py-16 sm:py-20 bg-slate-50 border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="inline-block bg-brand-red/10 text-brand-red text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4">Keep Exploring</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-blue mb-3">{title}</h2>
        <p class="text-slate-600 text-sm sm:text-base">{subtitle}</p>
      </div>

      {variant === 'cards' ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {links.map((link) => (
            <a href={link.href} class="group bg-white border border-brand-blue/10 rounded-2xl p-6 hover:shadow-lg hover:border-brand-blue/20 hover:-translate-y-0.5 transition-all duration-300 flex flex-col">
              <h3 class="text-base font-bold text-brand-blue mb-2 group-hover:text-brand-red transition-colors">{link.name}</h3>
              {link.description && <p class="text-sm text-slate-600 mb-4 flex-1">{link.description || link.name}</p>}
              <span class="text-sm font-semibold text-brand-blue group-hover:text-brand-red inline-flex items-center gap-1 mt-auto">
                Learn More
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <div class="flex flex-wrap justify-center gap-3">
          {links.map((link) => (
            <a href={link.href} class="inline-flex items-center gap-2 bg-white border border-slate-200 rounded-full px-5 py-2.5 text-sm font-semibold text-brand-blue hover:bg-brand-blue hover:text-white hover:border-brand-blue transition-colors shadow-sm">
              {link.name}
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
            </a>
          ))}
        </div>
      )}

      <div class="text-center mt-8">
        <a href="/services/" class="inline-flex items-center gap-2 text-sm font-bold text-slate-600 hover:text-brand-blue transition-colors">
          View all services
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
        </a>
      </div>
    </div>
  </section>
)}
